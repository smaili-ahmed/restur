# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL ─────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=123
PGDATABASE=cyberguard

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# ── Email OTP (Gmail SMTP) ────────────────────────────
# Create an App Password: Google Account → Security → 2-Step Verification
# → App passwords. SMTP_USER = your Gmail address, SMTP_PASS = the 16-char app password.
# Leave SMTP_USER empty in dev: the code is printed in the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ── Security ───────────────────────────────────────────
# Comma-separated list of trusted proxies (e.g. Cloudflare IPs)
# Use "loopback" in dev, "1" to trust all (behind single proxy)
TRUST_PROXY=loopback
# Allowed frontend origins (comma separated)
CLIENT_ORIGINS=http://localhost:5173

# ── Seed admin ─────────────────────────────────────────
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@cyberguard.io
SEED_ADMIN_PASSWORD=Admin123!
